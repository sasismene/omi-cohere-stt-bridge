PORT=10000
COHERE_API_KEY=replace-with-your-cohere-key
COHERE_STT_ENDPOINT=https://api.cohere.com/v2/audio/transcriptions
COHERE_STT_MODEL=cohere-transcribe-03-2026
COHERE_LANGUAGE=en
# Set to true only when your Omi client sends a shared secret in the
# Authorization: Bearer <value> WebSocket header.
BRIDGE_AUTH_ENABLED=false
BRIDGE_AUTH_TOKEN=
MAX_AUDIO_BYTES=25000000
SESSION_TIMEOUT_MS=90000
